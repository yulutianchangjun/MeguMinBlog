# ===== 部署用环境变量（复制为 .env，切勿提交真实密码）=====
# MySQL
MYSQL_DATABASE=blog_db
MYSQL_ROOT_PASSWORD=change-me-mysql

# Redis
REDIS_PASSWORD=change-me-redis

# JWT：至少 32 个字符
JWT_SECRET=change-me-to-a-random-32char-secret

# 博主账号不通过环境变量创建：用 node scripts/hash-password.mjs 生成哈希后手工插入 sys_user 表
# （见 docs/服务端部署指南.md「创建博主账号」一节）

# Cloudflare Turnstile（服务端 Secret，留空则跳过校验）
TURNSTILE_ENABLED=true
TURNSTILE_SECRET=
