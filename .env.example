# ===== 部署用环境变量（复制为 .env，切勿提交真实密码）=====
# MySQL
MYSQL_DATABASE=blog_db
MYSQL_ROOT_PASSWORD=change-me-mysql

# Redis
REDIS_PASSWORD=change-me-redis

# JWT：至少 32 个字符
JWT_SECRET=change-me-to-a-random-32char-secret

# 博主账号（首次启动自动创建；之后改这里不会覆盖已有密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_NICKNAME=云汀凫

# Cloudflare Turnstile（服务端 Secret，留空则跳过校验）
TURNSTILE_ENABLED=true
TURNSTILE_SECRET=
